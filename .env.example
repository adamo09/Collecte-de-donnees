# =====================================================================
# CADERAC — Collecte terrain — Variables d'environnement
# Copier ce fichier en .env puis adapter les valeurs.
# =====================================================================

# --- Base de données -------------------------------------------------
POSTGRES_USER=caderac
POSTGRES_PASSWORD=changer_ce_mot_de_passe
POSTGRES_DB=caderac
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL complète utilisée par l'application et Alembic.
# Laisser vide pour qu'elle soit reconstruite à partir des variables ci-dessus.
DATABASE_URL=

# --- Sécurité --------------------------------------------------------
# Générer une valeur aléatoire : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changer_cette_cle_en_production
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Application -----------------------------------------------------
ENVIRONNEMENT=developpement
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Délai au-delà duquel un trou de forage non clôturé déclenche une alerte
# (chapitre 6 du document de modélisation).
DELAI_ALERTE_TROU_NON_CLOTURE_HEURES=12

# Compte administrateur créé au premier démarrage (seed).
ADMIN_LOGIN=admin
ADMIN_MOT_DE_PASSE=changer_ce_mot_de_passe
ADMIN_NOM_COMPLET=Administrateur CADERAC
